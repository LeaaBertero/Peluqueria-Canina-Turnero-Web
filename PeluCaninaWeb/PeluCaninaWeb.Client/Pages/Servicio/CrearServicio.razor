@page "/api/Servicio/Crear"
@inject IHTTPServicio http;
@inject NavigationManager navigationManager;

<!DOCTYPE html>
<html class="@BodyClass">

<head>
    <title>Servicios</title>
</head>

<body>

    <header>
        <h1 class="text-center mb-4">Servicios</h1>

        <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="ToggleDarkMode">
            @(isDarkMode ? "🌙 Modo Claro" : "🌞 Modo Oscuro")
        </button>

        <EditForm Model="servicio" OnValidSubmit="Grabar" class="@FormClass">
            <DataAnnotationsValidator />
            @* <ValidationSummary /> *@

            <!-- Datos personales -->
            <h5 class="mb-3">Datos requeridos</h5>
            
            <div class="form-floating mb-3">
                <input type="text" @bind="servicio.Nombre" class="form-control @InputClass" id="nombre" placeholder="Nombre de servicio" />
                <label for="nombre">Nombre</label>
                <ValidationMessage For="@(() => servicio.Nombre)" />
            </div>
          
            <div class="form-floating mb-3">
                <input type="text" @bind="servicio.Descripcion" class="form-control @InputClass" id="nombre" placeholder="Descripción del servicio" />
                <label for="nombre">Descripción</label>
                <ValidationMessage For="@(() => servicio.Descripcion)" />
            </div>
           
            <div class="form-floating mb-3">
                <input type="text" @bind="servicio.Precio" class="form-control @InputClass" id="nombre" placeholder="Precio del servicio" />
                <label for="nombre">Precio</label>
                <ValidationMessage For="@(() => servicio.Precio)" />
            </div>

           

            <!-- Botones -->
            <div class="d-flex justify-content-between mt-4">

                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-person-plus"></i> Registrar
                </button>

                <button class="btn btn-outline-secondary" type="button" @onclick="Cancelar">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>

               @*  <button class="btn btn-outline-secondary" type="button" @onclick="VerLista">
                    <i class="bi bi-x-circle"></i> Ir a lista
                </button> *@


            </div>

        </EditForm>

    </header>

    <main></main>

    <footer class="mt-4">
        <p>Peluqueria Canina - Gestión de turnos</p>
    </footer>

</body>
</html>

@code {
    private Servicio servicio = new Servicio();
    private bool isDarkMode = false;

    private string BodyClass => isDarkMode ? "bg-dark text-light" : "bg-light";
    private string FormClass => isDarkMode ? "p-4 shadow rounded bg-dark text-light" : "p-4 shadow rounded bg-light";
    private string InputClass => isDarkMode ? "bg-dark text-light" : "";

    #region boton grabar datoss del formulario de entrada
    private async Task Grabar()
    {
        var httpRespuesta = await http.Post<Servicio>("api/Servicio", servicio);

        if (httpRespuesta.Error)
        {
            var body = httpRespuesta.HttpResponseMessage;
        }
    }
    #endregion

    #region boton cancelar
    private void Cancelar()
    {
        //vuelve a la pagina principal
        navigationManager.NavigateTo("/");
    }
    #endregion

    #region boton ver lista de usuarios registrados
    void VerLista()
    {
        //vuelve a la pagina principal
        navigationManager.NavigateTo("/api/ListaServicio"); 
    }
    #endregion

    private void ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
    }
}