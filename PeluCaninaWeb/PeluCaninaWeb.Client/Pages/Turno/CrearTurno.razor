@page "/api/Turno/Crear"
@inject IHTTPServicio http;
@inject NavigationManager navigationManager;

<!DOCTYPE html>
<html class="@BodyClass">

    <head>
        <title>Turnos</title>
    </head>

    <body>

        <header>
            
            <h1 class="text-center mb-4">Turnos</h1>

            <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="ToggleDarkMode">
                @(isDarkMode ? "🌙 Modo Claro" : "🌞 Modo Oscuro")
            </button>

            <EditForm Model="turno"OnValidSubmit="Grabar" class="@FormClass">
                <DataAnnotationsValidator />
                @* <ValidationSummary /> *@

                <!-- Datos personales -->
                <h5 class="mb-3">Datos personales</h5>
                <div class="form-floating mb-3">
                    <input type="date" @bind="turno.FechaHora" class="form-control @InputClass" id="FechaHora" placeholder="Nombre" />
                    <label for="nombre">Fecha / Hora</label>
                    <ValidationMessage For="@(() => turno.FechaHora)" />
                </div>
               
                <div class="form-floating mb-3">
                    <input type="text" @bind="turno.Nota" class="form-control @InputClass" id="FechaHora" placeholder="Nombre" />
                    <label for="nombre">Nota</label>
                    <ValidationMessage For="@(() => turno.Nota)" />
                </div>


              


               

              

                <!-- Botones -->
                <div class="d-flex justify-content-between mt-4">

                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-person-plus"></i> Registrar
                    </button>

                    <button class="btn btn-outline-secondary" type="button" @onclick="Cancelar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>

                  @*   <button class="btn btn-outline-secondary" type="button" @onclick="VerLista">
                        <i class="bi bi-x-circle"></i> Ir a lista
                    </button> *@


                </div>

            </EditForm>

        </header>

        <main></main>

        <footer class="mt-4">
            <p>Peluqueria Canina - Gestión de turnos</p>
        </footer>

    </body>
</html>

@code {
    private Turno turno = new Turno();
    private bool isDarkMode = false;

    private string BodyClass => isDarkMode ? "bg-dark text-light" : "bg-light";
    private string FormClass => isDarkMode ? "p-4 shadow rounded bg-dark text-light" : "p-4 shadow rounded bg-light";
    private string InputClass => isDarkMode ? "bg-dark text-light" : "";

    #region boton grabar datoss del formulario de entrada
    private async Task Grabar()
    {
        var httpRespuesta = await http.Post<Turno>("api/Turno", turno);

        if (httpRespuesta.Error)
        {
            var body = httpRespuesta.HttpResponseMessage;
        }
    }
    #endregion

    #region boton cancelar
    private void Cancelar()
    {
        //vuelve a la pagina principal
        navigationManager.NavigateTo("/");
    }
    #endregion

    #region boton ver lista de usuarios registrados
    void VerLista()
    {
        //vuelve a la pagina principal
        navigationManager.NavigateTo("api/ListaTurno");
    }
    #endregion

    private void ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
    }



   

}