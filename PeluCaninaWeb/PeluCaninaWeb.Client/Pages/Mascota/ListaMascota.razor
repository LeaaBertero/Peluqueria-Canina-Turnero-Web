@page "/api/ListaMascota"
@inject IHTTPServicio http;
@inject NavigationManager navigationManager;

<h1 class="text-center mb-4 text-primary fw-bold">
    👥 Lista de Mascotas
</h1>

<div class="d-flex justify-content-between mb-3">
    @* <a class="btn btn-success" href="/Api/Mascota/Crear">
        <i class="bi bi-person-plus"></i> Voler atrás
    </a> *@
    <a class="btn btn-outline-secondary" href="/">
        <i class="bi bi-house-door"></i> Ir a la web
    </a>
</div>

@if (listaMascota == null)
{
    <div class="alert alert-info text-center">
        <i class="bi bi-search"></i> Buscando Mascotas registrados...
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Edad</th>
                    <th>Peso</th>
                    <th>Descripcion</th>
                    <th>Especie</th>
                    <th>Raza</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in listaMascota)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Edad</td>
                        <td>@item.Peso</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Especie</td>
                        <td>@item.Raza</td>

                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex justify-content-between mb-3">
    @*  <a class="btn btn-success" href="/Api/Usuario/Crear">
            <i class="bi bi-person-plus"></i> Voler atrás
        </a> *@
    <a class="btn btn-outline-secondary" href="/admin">
        <i class="bi bi-house-door"></i> Volver al inicio
    </a>
</div>

@code {
    List<Mascota> listaMascota;

    string Mensaje;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await Leer();
    }

    private async Task Leer()
    {
        var respuesta = await http.Get<List<Mascota>>("api/Mascota");
        if (!respuesta.Error)
        {
            listaMascota = respuesta.Respuesta;
        }
        else
        {
            Mensaje = await respuesta.ObtenerError();
        }

    }
}
