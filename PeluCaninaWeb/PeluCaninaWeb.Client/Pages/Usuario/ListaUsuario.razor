@page "/api/ListaUsuario"
@inject IHTTPServicio http;
@inject NavigationManager navigationManager;



<h1 class="text-center mb-4 text-primary fw-bold">
    👥 Lista de Usuarios
</h1>

<div class="d-flex justify-content-between mb-3">
   @*  <a class="btn btn-success" href="/Api/Usuario/Crear">
        <i class="bi bi-person-plus"></i> Voler atrás
    </a> *@
    <a class="btn btn-outline-secondary" href="/">
        <i class="bi bi-house-door"></i> Ir a la web
    </a>
</div>

@if (listausuario == null)
{
    <div class="alert alert-info text-center">
        <i class="bi bi-search"></i> Buscando usuarios registrados...
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>E-mail</th>
                    <th>Contraseña</th>
                    <th>Teléfono</th>
                    <th>Roles</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in listausuario)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.Email</td>
                        <td>@item.Contrasenia</td>
                        <td>@item.Telefono</td>
                        <td>
                            @if (item.Roles != null && item.Roles.Any())
                            {
                                <!-- Mostrar roles separados por coma -->
                                @string.Join(", ", item.Roles.Select(r => r.NombreRol))
                            }
                            else
                            {
                                <span>Sin roles</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}

    <div class="d-flex justify-content-between mb-3">
        @*  <a class="btn btn-success" href="/Api/Usuario/Crear">
            <i class="bi bi-person-plus"></i> Voler atrás
        </a> *@
        <a class="btn btn-outline-secondary" href="/admin">
            <i class="bi bi-house-door"></i> Volver al inicio
        </a>
    </div>


@code {
    List<Usuario> listausuario;

    string Mensaje;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await Leer();
    }

    private async Task Leer()
    {
        var respuesta = await http.Get<List<Usuario>>("api/Usuario");
        if (!respuesta.Error)
        {
            listausuario = respuesta.Respuesta;
        }
        else
        {
            Mensaje = await respuesta.ObtenerError();
        }

    }
}
