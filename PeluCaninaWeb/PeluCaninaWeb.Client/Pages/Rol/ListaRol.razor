@page "/api/ListaRol"
@inject IHTTPServicio http;
@inject NavigationManager navigationManager;



<h1 class="text-center mb-4 text-primary fw-bold">
    👥 Lista de roles
</h1>

<div class="d-flex justify-content-between mb-3">
     <a class="btn btn-success" href="/api/Rol/Crear">
        <i class="bi bi-person-plus"></i> Nuevo rol
    </a>
    <a class="btn btn-outline-secondary" href="/">
        <i class="bi bi-house-door"></i> Ir a la web
    </a>
</div>

@if (listarol == null)
{
    <div class="alert alert-info text-center">
        <i class="bi bi-search"></i> Buscando roles registrados...
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>NombreRol</th>
                   
                </tr>
            </thead>
            <tbody>
                @foreach (var item in listarol)
                {
                    <tr>
                        <td>@item.NombreRol</td>
                       

                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex justify-content-between mb-3">
    @*  <a class="btn btn-success" href="/Api/Usuario/Crear">
            <i class="bi bi-person-plus"></i> Voler atrás
        </a> *@
    <a class="btn btn-outline-secondary" href="/admin">
        <i class="bi bi-house-door"></i> Volver al inicio
    </a>
</div>


@code {
    List<Rol> listarol;

    string Mensaje;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await Leer();
    }

    private async Task Leer()
    {
        var respuesta = await http.Get<List<Rol>>("api/Rol");
        if (!respuesta.Error)
        {
            listarol = respuesta.Respuesta;
        }
        else
        {
            Mensaje = await respuesta.ObtenerError();
        }

    }
}
